<?xml version="1.0"?>
<package format="3">
  <name>rgbd_camera</name><version>0.2.0</version>
  <description>Shared OAK and RealSense RGB-D acquisition with optional integrated IMU.</description>
  <maintainer email="pbeuchat@unimelb.edu.au">Paul N. Beuchat</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>rclcpp_components</depend>
  <depend>rcl_interfaces</depend><depend>sensor_msgs</depend>
  <depend>rgbd_camera_interfaces</depend>
  <depend>openssl</depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>rclpy</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
